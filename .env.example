# ======================================================================
# TOAP Spin & Win — environment template
# Copy to .env.local (development) or set in the hosting dashboard.
# Never commit a filled-in copy of this file.
# ======================================================================

# ---- Application ----
APP_MODE=development                 # development | test | production
NEXT_PUBLIC_APP_URL=http://localhost:3000
EVENT_CODE=TOAP2026                  # event the public site serves (scripts)

# ---- Supabase PostgreSQL ----
# Project settings -> API. The service role key is server-side only:
# it must never appear in NEXT_PUBLIC_* or in client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Secrets (generate each with: openssl rand -base64 48) ----
SESSION_SECRET=                      # signs participant/admin session cookies, min 32 chars
OTP_PEPPER=                          # HMAC pepper for stored OTP hashes, min 32 chars

# ---- SMS OTP (Semaphore Philippines) ----
SMS_PROVIDER=console                 # semaphore | console
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# ---- Email OTP (Resend) ----
EMAIL_PROVIDER=console               # resend | console
RESEND_API_KEY=
EMAIL_FROM="TOAP Spin & Win <noreply@credenceanalytics.com>"

# ---- Development / testing only ----
# Simulated OTP delivery: codes are logged to the server console instead of
# being sent. Startup fails if this is true while APP_MODE=production.
OTP_DEV_MODE=true
# Ignores the event's registration/spin time windows. Testing only.
ADMIN_EVENT_OVERRIDE=false
# Used by tests/integration and scripts/concurrency-test.ts, not by the app.
TEST_DATABASE_URL=
BASE_URL=http://localhost:3000       # target for scripts/smoke-test.ts
